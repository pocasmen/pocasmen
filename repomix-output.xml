            .optional(),
        nif: z.string()
            .regex(/^\d{9}$/, 'NIF deve ter exatamente 9 dígitos')
    })
});

export const updateClientSchema = z.object({
    params: z.object({
        id: z.string().regex(/^\d+$/, 'ID inválido')
    }),
