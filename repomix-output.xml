        const p2 = await client.query(`INSERT INTO parts (reference, designation, stock_quantity, reserved_quantity, is_composed) VALUES ('INT-JANTE', 'Jante Original', 20, 0, false) RETURNING id`);
        const idPneu = p1.rows[0].id;
